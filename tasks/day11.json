{
  "day": 11,
  "title": "Dataset/DataLoader",
  "goal": "掌握数据加载",
  "difficulty": 3,
  "estimated_minutes": 90,
  "prerequisites": [
    "Tensor基础",
    "nn.Module前向"
  ],
  "learn": [
    "Dataset协议：__len__与__getitem__",
    "DataLoader的batch_size与shuffle语义",
    "尾批现象",
    "transform的作用位置"
  ],
  "review_points": [
    "nn.Module",
    "Linear"
  ],
  "required_api": [
    {
      "name": "SimpleDataset",
      "signature": "SimpleDataset(data, labels, transform=None) -> Dataset",
      "description": "实现__len__与__getitem__；item返回(特征, 标签)二元组；transform存在时先作用于特征"
    },
    {
      "name": "make_loader",
      "signature": "make_loader(dataset, batch_size, shuffle=False) -> DataLoader",
      "description": "把batch_size与shuffle透传给DataLoader并返回"
    }
  ],
  "core_task": "实现自定义数据集",
  "mastery": [
    "能实现__len__/__getitem__的自定义Dataset",
    "能算出给定batch_size下的batch数量与尾批大小",
    "知道transform应在__getitem__内生效"
  ],
  "optional_challenge": "挑战：实现返回变长序列的Dataset，并编写collate_fn完成padding批处理",
  "skills": [
    "pytorch.dataset",
    "pytorch.dataloader"
  ],
  "tests": [
    "test_answer_module_imports",
    "test_batches_count",
    "test_getitem_types",
    "test_is_dataset_subclass",
    "test_last_batch_smaller",
    "test_len_and_getitem",
    "test_transform_applied"
  ],
  "test_module": "day11_test",
  "task": "实现自定义数据集",
  "description": "学习PyTorch的数据加载机制，实现自定义Dataset和DataLoader。理解数据预处理。",
  "hints": [
    "继承Dataset类实现__getitem__和__len__",
    "使用DataLoader批量加载",
    "使用transforms进行数据预处理"
  ],
  "hint_levels": [
    {
      "level": 1,
      "content": "Dataset核心是两个方法：一个报总数，一个按索引取样本"
    },
    {
      "level": 2,
      "content": "__getitem__返回(特征, 标签)二元组；transform若有则先作用于特征"
    },
    {
      "level": 2,
      "content": "make_loader里把batch_size与shuffle透传给DataLoader"
    },
    {
      "level": 3,
      "content": "伪代码：__len__返回样本数；__getitem__: 取x后若transform则先变换，再return x与labels[i]"
    }
  ]
