{
  "day": 8,
  "title": "Tensor基础",
  "goal": "掌握Tensor操作",
  "difficulty": 2,
  "estimated_minutes": 90,
  "prerequisites": [
    "Python slicing",
    "NumPy shape"
  ],
  "learn": [
    "Tensor创建与dtype",
    "reshape与元素数守恒",
    "统计与索引"
  ],
  "review_points": [
    "gradient descent",
    "MSE loss"
  ],
  "required_api": [
    {
      "name": "create_tensor",
      "signature": "create_tensor(data) -> Tensor",
      "description": "返回dtype=float32的tensor"
    },
    {
      "name": "reshape_tensor",
      "signature": "reshape_tensor(t, shape) -> Tensor",
      "description": "按tuple形状reshape；元素数不匹配时让PyTorch报错"
    },
    {
      "name": "tensor_stats",
      "signature": "tensor_stats(t) -> (mean, std)",
      "description": "返回均值与标准差"
    },
    {
      "name": "index_last",
      "signature": "index_last(t) -> Tensor",
      "description": "取展平后的最后一个元素"
    }
  ],
  "core_task": "实现常见Tensor操作",
  "mastery": [
    "能解释Tensor的shape和dtype",
    "能完成reshape且不改变元素数量",
    "能使用索引取得指定元素",
    "知道CPU/GPU Tensor需要位于同一device"
  ],
  "optional_challenge": "挑战：比较CPU Tensor与可用GPU Tensor的矩阵乘法耗时；练习broadcasting与花式索引（如提取对角线）",
  "skills": [
    "pytorch.tensor"
  ],
  "tests": [
    "test_answer_module_imports",
    "test_create_tensor_dtype",
    "test_create_tensor_values",
    "test_index_last",
    "test_reshape_invalid_shape_raises",
    "test_reshape_preserves_elements",
    "test_stats_values"
  ],
  "test_module": "day08_test",
  "task": "实现常见Tensor操作",
  "description": "学习PyTorch的Tensor基础，包括创建、索引、变形、运算等操作。理解GPU加速计算。",
  "hints": [
    "使用torch.tensor()或torch.zeros/ones/rand创建",
    "使用view()或reshape()变形",
    "使用切片进行索引"
  ],
  "hint_levels": [
    {
      "level": 1,
      "content": "创建Tensor时注意把dtype显式指定为浮点类型"
    },
    {
      "level": 2,
      "content": "t.reshape(*shape)；统计用t.mean()/t.std()"
    },
    {
      "level": 2,
      "content": "torch.tensor(data, dtype=torch.float32)"
    },
    {
      "level": 3,
      "content": "t.view(-1) 或 t.flatten() 可以展平tensor"
    }
  ]
}
